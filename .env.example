# ==================== 环境变量模板 ====================
# 重命名为 .env 后填入真实密钥
# 说明: 所有带默认值的项可留空；关键项为 DASHSCOPE_API_KEY

# ==================== LLM / Embedding ====================
# DashScope (阿里云百炼) API Key
# 申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# LLM 提供商 / 模型
LLM_PROVIDER=tongyi
# qwen3-max follows the requested target stack; set qwen3.7-max if your DashScope region exposes the newer Max family.
LLM_MODEL=qwen3-max
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Embedding 模型 / 维度
EMBEDDING_PROVIDER=tongyi
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=256

# ==================== HuggingFace 配置 ====================
# 国内镜像（兜底，离线模式下不生效但无害）
HF_ENDPOINT=https://hf-mirror.com
# 离线模式: 1=仅使用本地缓存（避免外网卡死），0=允许在线下载
HF_HUB_OFFLINE=1
HF_HUB_DOWNLOAD_TIMEOUT=10

# ==================== 数据库 ====================
# 类型 / 路径
DB_TYPE=sqlite
DB_PATH=data/finance.db
# 只读模式（线上推荐 true，避免误写）
DB_READ_ONLY=true
DB_TIMEOUT=30
DB_MAX_ROWS=1000

# ==================== FAISS 向量库 ====================
FAISS_INDEX_PATH=data/faiss_index
FAISS_INDEX_TYPE=flat
FAISS_TOP_K=5
RAG_RERANK_ENABLED=false
FAISS_MMR_ENABLED=false
FAISS_MMR_LAMBDA=0.7
FAISS_SCORE_THRESHOLD=0.3

# ==================== LangGraph runtime ====================
LANGGRAPH_CHECKPOINTER=sqlite
LANGGRAPH_SQLITE_PATH=data/checkpoints/langgraph.sqlite
LANGGRAPH_RECURSION_LIMIT=8
RAG_RELEVANCE_THRESHOLD=0.35
RAG_MAX_REWRITE_RETRIES=1
RAG_TOP_K=5
RAG_FETCH_K=12

# Redis Stack is recommended for production checkpointer storage.
REDIS_URL=redis://localhost:6379/0
LANGGRAPH_CHECKPOINT_TTL_MINUTES=1440

# ==================== Milvus vector database ====================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=finance_report_chunks
MILVUS_VECTOR_FIELD=vector
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_BATCH_SIZE=128
MILVUS_TIMEOUT=20

# ==================== bm25s lexical retrieval ====================
BM25S_INDEX_PATH=data/bm25s_index
BM25S_MMAP=true
RRF_K=60
RRF_VECTOR_WEIGHT=0.65
RRF_BM25_WEIGHT=0.35

# ==================== Rerank model ====================
RERANK_MODEL=BAAI/bge-large-zh-v1.5
RERANK_DEVICE=cpu

# ==================== LangSmith tracing ====================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fin-research-langgraph

# ==================== Prometheus / Grafana ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==================== 文档切分 ====================
SPLIT_STRATEGY=recursive
SPLIT_CHUNK_SIZE=500
SPLIT_CHUNK_OVERLAP=100

# ==================== SQL 执行器 ====================
SQL_TIMEOUT=30
SQL_MAX_ROWS=1000

# ==================== PDF 智能处理 ====================
# 阈值: 页面字符数 < 此值判定为扫描件
PDF_TEXT_THRESHOLD=50
# OCR 后端: paddleocr（本地） / vision（调用视觉模型）
PDF_OCR_BACKEND=paddleocr
# 视觉理解模型
PDF_VL_MODEL=qwen-vl-max
# 是否对表格页面启用视觉理解
PDF_VISION_FOR_TABLES=true
# 渲染 DPI（越高越清晰，内存越大）
PDF_RENDER_DPI=200

# ==================== 爬虫配置 ====================
# 是否启用爬虫（默认关闭，按需开启）
CRAWLER_ENABLED=false
# 请求间隔（秒，遵守 robots.txt）
CRAWLER_DELAY=2.0
# 最大页数
CRAWLER_MAX_PAGES=50
# 保存目录
CRAWLER_SAVE_DIR=data/docs/crawled

# ==================== FastAPI 安全 ====================
# API Key 认证（空则关闭认证，仅推荐本地调试）
API_KEY=
# 每分钟请求限流（仅当安装了 slowapi 时生效，0=不限流）
RATE_LIMIT_PER_MINUTE=60
# CORS 允许源，逗号分隔
# 留空则默认仅允许 localhost:3000/8000/8080/8050
CORS_ORIGINS=
# 监听地址 / 端口
API_HOST=127.0.0.1
API_PORT=8000
API_TIMEOUT_SECONDS=30
MAX_DOCUMENT_MB=50
DASH_PORT=8050

# ==================== 环境保护 ====================
# dev / test / production
# 设置为 production 后，init_data.py --force 将被禁止
ENVIRONMENT=dev

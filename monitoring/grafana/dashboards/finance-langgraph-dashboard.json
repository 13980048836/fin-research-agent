      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(finrag_http_requests_total[5m]))",
          "legendFormat": "requests/sec"
        }
      ],
      "title": "API Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(finrag_graph_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 graph latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(finrag_retrieval_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 retrieval latency"
        }
      ],
      "title": "Latency P95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(finrag_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(finrag_http_requests_total[5m])), 1)",
          "legendFormat": "5xx error rate"
        }
      ],
      "title": "Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(increase(finrag_llm_tokens_total[1h])) by (kind)",
          "legendFormat": "{{kind}}"
